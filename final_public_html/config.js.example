    SOCIAL: {
        INSTAGRAM: 'https://www.instagram.com/IghisHomeRadio/',
        TIKTOK: 'https://www.tiktok.com/@ighishomeradio',
        TWITTER: 'https://x.com/IghisHomeRadio',
        FACEBOOK: 'https://www.facebook.com/@ighi.s.home.radio',
        PAYPAL: 'https://paypal.me/ighishomeradio?country.x=CZ&locale.x=en_US',
