    // Contact Information
    CONTACT: {
        EMAIL_GENERAL: 'hello@ighishomeradio.com',
        EMAIL_REQUESTS: 'requests@ighishomeradio.com',
        PHONE: '+420603946930',
        PHONE_DISPLAY: '+420 603 946 930',
    },
    
    // Development/Production
    ENVIRONMENT: 'production', // 'development' alebo 'production'
    DEBUG: false, // true pre debug výpisy v console
    
    // API Endpoints (pre vlastný backend)
    API: {
        BASE_URL: '', // Ak máte vlastný backend
        CALLBACK_URL: '', // Pre AudD callbacks
