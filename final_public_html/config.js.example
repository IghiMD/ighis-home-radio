            en: 'Unable to recognize the song.',
            sk: 'Nepodarilo sa rozpoznať skladbu.'
        },
        PLAYBACK_ERROR: {
            en: 'Playback failed. Please refresh the page.',
            sk: 'Prehrávanie zlyhalo. Obnovte stránku.'
        }
    }
};

// Export pre použitie v hlavnom súbore
if (typeof module !== 'undefined' && module.exports) {
    module.exports = RADIO_CONFIG;
}

// Pre browser environment
if (typeof window !== 'undefined') {
    window.RADIO_CONFIG = RADIO_CONFIG;
}

/* 
POUŽITIE V HTML:

1. Pridajte pred hlavný script:
<script src="config.js"></script>

2. V hlavnom scripte použite:
const CONFIG = window.RADIO_CONFIG || {
    AUDD: { API_TOKEN: 'demo', LONGPOLL_CATEGORY: '' },
    CRISP: { WEBSITE_ID: 'demo' },
    STREAM: { URL: 'https://...' }
};

3. Príklad použitia:
if (CONFIG.DEBUG) {
    console.log('Debug mode enabled');
}

if (CONFIG.FEATURES.ENABLE_RECOGNITION && CONFIG.AUDD.API_TOKEN !== 'demo') {
    startMusicRecognition();
}
*/

// Validácia konfigurácie
function validateConfig() {
    const errors = [];
    
    if (!RADIO_CONFIG.AUDD.API_TOKEN || RADIO_CONFIG.AUDD.API_TOKEN === 'YOUR_AUDD_API_TOKEN_HERE') {
        errors.push('AudD API token is not configured');
    }
    
    if (!RADIO_CONFIG.CRISP.WEBSITE_ID || RADIO_CONFIG.CRISP.WEBSITE_ID === 'YOUR_CRISP_WEBSITE_ID_HERE') {
        errors.push('Crisp Website ID is not configured');
    }
    
    if (!RADIO_CONFIG.STREAM.URL) {
        errors.push('Stream URL is not configured');
    }
    
    if (errors.length > 0) {
        console.error('Configuration errors:', errors);
        return false;
    }
    
    return true;
}

// Auto-validácia pri načítaní
if (typeof window !== 'undefined') {
    window.addEventListener('DOMContentLoaded', () => {
        if (RADIO_CONFIG.DEBUG || RADIO_CONFIG.ENVIRONMENT === 'development') {
            const isValid = validateConfig();
            if (!isValid) {
                console.warn('⚠️ Please configure your API keys in config.js');
            } else {
                console.log('✅ Configuration validated successfully');
            }
        }
    });
}