<?php
/**
 * AI_INFO MINIMAL - Ultra-jednoduchá funkčná verzia
 * Bez komplikovaných závislostí - VŽDY FUNGUJE
 */

header('Content-Type: application/json; charset=utf-8');
header('Access-Control-Allow-Origin: *');
header('Access-Control-Allow-Methods: GET, POST');

// Zakáž error reporting pre čistý JSON output
error_reporting(0);
ini_set('display_errors', 0);

// Získaj parametre
$artist = trim($_GET['artist'] ?? '');
$title = trim($_GET['title'] ?? '');
$lang = $_GET['lang'] ?? 'en';
$maxWords = (int)($_GET['max_words'] ?? 50);

// Validácia
if (empty($artist) || empty($title)) {
    echo json_encode(['error' => 'Missing parameters']);
    exit;
}

if (!in_array($lang, ['en', 'sk'])) {
    $lang = 'en';
}

// Fallback content - vždy funguje
function getContent($artist, $title, $lang) {
    $fallbacks = [
        'sk' => [
            "Skladba '{$title}' od {$artist} predstavuje zaujímavý príklad hudobného umenia. Dielo vyniká precíznym spracovaním a jedinečným prístupom k žánru.",
            "{$artist} vytvoril kompozíciu, ktorá elegantne spája tradičné prvky s moderným prístupom. Výsledkom je dielo oslovujúce široké publikum.",
            "Táto skladba demonštruje majstrovské ovládanie žánru. {$artist} dokázal vytvoriť nadčasové dielo.",
            "'{$title}' je dôkazom toho, že kvalitná hudba dokáže spájať generácie. Skladba kombinuje technickú dokonalosť s emocionálnou hĺbkou.",
            "{$artist} vytvoril dielo, ktoré rezonuje s poslucháčmi všetkých vekových kategórií. Skladba '{$title}' je skutočným hudobným skvostom."
        ],
        'en' => [
            "The composition '{$title}' by {$artist} represents an intriguing example of musical artistry. The work excels in precise craftsmanship and unique genre approach.",
            "{$artist} crafted a track that elegantly combines traditional elements with contemporary approaches. The result appeals to a wide audience.",
            "This musical piece demonstrates masterful genre command. {$artist} managed to create a timeless work.",
            "'{$title}' proves that quality music can unite generations. The track combines technical perfection with emotional depth.",
            "{$artist} created a work that resonates with listeners of all ages. The track '{$title}' is a true musical gem."
        ]
    ];
    
    $options = $fallbacks[$lang] ?? $fallbacks['en'];
    return $options[array_rand($options)];
}

// Skús OpenAI ak je dostupný
$aiContent = null;

// Načítaj config ak existuje
if (file_exists('config.php')) {
    try {
        require_once 'config.php';
        
        // Skús OpenAI
        if (defined('OPENAI_API_KEY') && !empty(OPENAI_API_KEY)) {
            $prompt = $lang === 'sk' ? 
                "Napíš krátky kultivovaný komentár o skladbe '{$title}' od {$artist}. Maximálne 2 vety." :
                "Write a short cultured commentary about '{$title}' by {$artist}. Maximum 2 sentences.";
                
            $ch = curl_init();
            curl_setopt($ch, CURLOPT_URL, 'https://api.openai.com/v1/chat/completions');
            curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
            curl_setopt($ch, CURLOPT_POST, true);
            curl_setopt($ch, CURLOPT_TIMEOUT, 10);
            curl_setopt($ch, CURLOPT_POSTFIELDS, json_encode([
                'model' => 'gpt-3.5-turbo',
                'messages' => [['role' => 'user', 'content' => $prompt]],
                'max_tokens' => 100,
                'temperature' => 0.7
            ]));
            curl_setopt($ch, CURLOPT_HTTPHEADER, [
                'Authorization: Bearer ' . OPENAI_API_KEY,
                'Content-Type: application/json'
            ]);
            
            $response = curl_exec($ch);
            $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
            curl_close($ch);
            
            if ($httpCode === 200) {
                $result = json_decode($response, true);
                if (isset($result['choices'][0]['message']['content'])) {
                    $aiContent = trim($result['choices'][0]['message']['content']);
                }
            }
        }
    } catch (Exception $e) {
        // Pokračuj s fallback obsahom
    }
}

// Použij AI content alebo fallback
$content = $aiContent ?: getContent($artist, $title, $lang);

// Limituj počet slov
$words = explode(' ', $content);
if (count($words) > $maxWords) {
    $content = implode(' ', array_slice($words, 0, $maxWords)) . '.';
}

// Výsledok
echo json_encode([
    'content' => $content,
    'artist' => $artist,
    'title' => $title,
    'lang' => $lang,
    'provider' => $aiContent ? 'OpenAI' : 'Fallback',
    'timer_seconds' => 25,
    'can_skip' => true,
    'word_count' => str_word_count($content),
    'timestamp' => time(),
    'version' => 'minimal'
], JSON_UNESCAPED_UNICODE);

exit;
?>