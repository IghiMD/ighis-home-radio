require_once 'config.php';

// Immediate output buffering
ob_start();

// Headers FIRST
header('Content-Type: application/json; charset=utf-8');
header('Access-Control-Allow-Origin: *');
header('Access-Control-Allow-Methods: GET, POST');
header('Access-Control-Allow-Headers: Content-Type, X-API-Token');

// Error handling
ini_set('display_errors', 0);
ini_set('log_errors', 1);
error_reporting(E_ALL & ~E_WARNING);

// API Token check for security (optional)
$token = $_SERVER['HTTP_X_API_TOKEN'] ?? $_GET['token'] ?? '';
// Skip token check for now - just log access
error_log('AI info accessed from: ' . ($_SERVER['REMOTE_ADDR'] ?? 'unknown'));

// Configuration from config.php
define('DEFAULT_MAX_WORDS', AI_MAX_WORDS);
define('DEFAULT_TIMER_SECONDS', AI_DEFAULT_TIMER);
define('MIN_TIMER_SECONDS', AI_MIN_TIMER);
define('MAX_CHARACTERS', 2000);  // ✅ NOVÉ - Max počet znakov

// NOVÉ: Konfigurácia pre gentlemanský štýl
define('GENTLEMAN_STYLE_WORDS', [
    'sk' => ['komponoval', 'vytvoril', 'predstavuje', 'demonštruje', 'charakterizuje', 'vyniká', 'odráža'],
    'en' => ['composed', 'crafted', 'represents', 'demonstrates', 'characterizes', 'excels', 'reflects']
]);

// Bulvárne frázy na vylúčenie
define('FORBIDDEN_PHRASES', [
    'sk' => ['vedeli ste', 'wau', 'neuveriteľné', 'šokujúce', 'tajomstvo', 'odhalenie'],
    'en' => ['did you know', 'wow', 'unbelievable', 'shocking', 'secret', 'revelation']
]);

// Create directories silently
if (!file_exists(AI_CACHE_DIR)) {
    @mkdir(AI_CACHE_DIR, 0755, true);
}

function getCacheKey($artist, $title, $lang, $style = 'gentleman') {
    return md5(strtolower(trim($artist)) . '_' . strtolower(trim($title)) . '_' . $lang . '_' . $style);
}

function getFromCache($key) {
    $cacheFile = AI_CACHE_DIR . $key . '.json';
    if (file_exists($cacheFile)) {
        $data = json_decode(file_get_contents($cacheFile), true);
        if ($data && isset($data['expires']) && $data['expires'] > time()) {
            return $data['content'];
        }
        @unlink($cacheFile);
    }
    return null;
}

function saveToCache($key, $content) {
    $cacheFile = AI_CACHE_DIR . $key . '.json';
    $data = [
        'content' => $content,
        'expires' => time() + TRIVIA_CACHE_EXPIRY,
        'created' => time()
    ];
    @file_put_contents($cacheFile, json_encode($data, JSON_UNESCAPED_UNICODE));
}

/**
 * ENHANCED: DeepL Pro API Translation
 */
function translateWithDeepLPro($text, $targetLang = 'SK', $sourceDetected = false) {
    if (!DEEPL_API_KEY || empty($text)) return $text;
    
    // Detekcia jazyka ak nie je zadaný
    $sourceLang = $sourceDetected ? 'auto' : 'EN';
    
    $url = 'https://api-free.deepl.com/v2/translate';
    $data = [
        'auth_key' => DEEPL_API_KEY,
        'text' => $text,
        'target_lang' => strtoupper($targetLang),
        'formality' => 'more', // Formálnejší štýl pre gentlemanský prístup
        'preserve_formatting' => 1
    ];
    
    if ($sourceLang !== 'auto') {
        $data['source_lang'] = $sourceLang;
    }
    
    $ch = curl_init();
    curl_setopt($ch, CURLOPT_URL, $url);
    curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
    curl_setopt($ch, CURLOPT_POST, true);
    curl_setopt($ch, CURLOPT_POSTFIELDS, http_build_query($data));
    curl_setopt($ch, CURLOPT_HTTPHEADER, ['Content-Type: application/x-www-form-urlencoded']);
    curl_setopt($ch, CURLOPT_TIMEOUT, 10);
    
    $response = curl_exec($ch);
    $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
    curl_close($ch);
    
    if ($httpCode === 200) {
        $result = json_decode($response, true);
        if (isset($result['translations'][0]['text'])) {
            return cleanGentlemanText($result['translations'][0]['text'], $targetLang);
        }
    }
    
    return $text; // Return original if translation fails
}

/**
 * NOVÉ: Čistenie textu pre gentlemanský štýl
 */
function cleanGentlemanText($text, $lang) {
    // Odstránenie bulvárnych frázok
    $forbidden = FORBIDDEN_PHRASES[$lang] ?? FORBIDDEN_PHRASES['en'];
    
    foreach ($forbidden as $phrase) {
        $text = str_ireplace($phrase, '', $text);
    }
    
    // Odstránenie extra medzier a čistenie
    $text = preg_replace('/\s+/', ' ', $text);
    $text = trim($text);
    
    // Zabezpečenie veľkého písmena na začiatku
    $text = ucfirst($text);
    
    return $text;
}

/**
 * ENHANCED: Perplexity s gentlemánskym štýlom
 */
function callPerplexityForFacts($prompt, $lang = 'en', $maxWords = DEFAULT_MAX_WORDS) {
    if (!isServiceEnabled('perplexity')) return null;
    
    $systemPrompt = $lang === 'sk' ?
        "Si erudovaný hudobný kritik s vychovaním gentlemana. Píš sofistikované, kultivované texty o hudbe bez bulvárnych frázok. Používaj formálny, ale príjemný tón." :
        "You are an erudite music critic with gentlemanly education. Write sophisticated, cultured texts about music without tabloid phrases. Use formal but pleasant tone.";
    
    $data = [
        'model' => 'llama-3.1-sonar-small-128k-online',
        'messages' => [
            ['role' => 'system', 'content' => $systemPrompt],
            ['role' => 'user', 'content' => $prompt]
        ],
        'temperature' => 0.4,
        'max_tokens' => 150  // ✅ ZVÝŠENÉ z 200 na 800
    ];
    
    $ch = curl_init();
    curl_setopt($ch, CURLOPT_URL, 'https://api.perplexity.ai/chat/completions');
    curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
    curl_setopt($ch, CURLOPT_POST, true);
    curl_setopt($ch, CURLOPT_POSTFIELDS, json_encode($data));
    curl_setopt($ch, CURLOPT_HTTPHEADER, [
        'Authorization: Bearer ' . PERPLEXITY_API_KEY,
        'Content-Type: application/json'
    ]);
    curl_setopt($ch, CURLOPT_TIMEOUT, 15);
    
    $response = curl_exec($ch);
    $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
    curl_close($ch);
    
    if ($httpCode === 200) {
        $result = json_decode($response, true);
        if (isset($result['choices'][0]['message']['content'])) {
            $content = cleanGentlemanText($result['choices'][0]['message']['content'], $lang);
            $content = limitWords($content, $maxWords);
            
            // Preložiť ak potrebné (Perplexity občas odpovie v ENG aj pre SK)
            if ($lang === 'sk' && !containsSlovakDiacritics($content)) {
                $content = translateWithDeepLPro($content, 'SK');
            }
            
            return $content;
        }
    }
    return null;
}

/**
 * ENHANCED: GPT-4 s gentlemánskym štýlom a 2 kľúčmi
 */
function callGPT4($prompt, $lang = 'en', $maxWords = DEFAULT_MAX_WORDS) {
    if (!isServiceEnabled('openai')) return null;
    
    // Získaj aktívny OpenAI kľúč
    $apiKey = getActiveOpenAIKey();
    if (!$apiKey) return null;
    
    $systemPrompt = $lang === 'sk' ?
        "Si sofistikovaný hudobný analytik. Vytváraj kultivované, intelektuálne texty o hudbe v slovenčine. Vyhýbaj sa bulvárnym frázkam ako 'vedeli ste' a podobne." :
        "You are a sophisticated music analyst. Create cultured, intellectual texts about music in English. Avoid tabloid phrases like 'did you know' and similar.";
    
    $data = [
        'model' => 'gpt-3.5-turbo',
        'messages' => [
            ['role' => 'system', 'content' => $systemPrompt],
            ['role' => 'user', 'content' => $prompt]
        ],
        'max_tokens' => 150,  // ✅ ZVÝŠENÉ z 200 na 800
        'temperature' => 0.5
    ];
    
    $ch = curl_init();
    curl_setopt($ch, CURLOPT_URL, 'https://api.openai.com/v1/chat/completions');
    curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
    curl_setopt($ch, CURLOPT_POST, true);
    curl_setopt($ch, CURLOPT_POSTFIELDS, json_encode($data));
    curl_setopt($ch, CURLOPT_HTTPHEADER, [
        'Authorization: Bearer ' . $apiKey,
        'Content-Type: application/json'
    ]);
    curl_setopt($ch, CURLOPT_TIMEOUT, 15);
    
    $response = curl_exec($ch);
    $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
    curl_close($ch);
    
    // Ak hlavný kľúč zlyhal, označ to a skús znova
    if ($httpCode === 401 && $apiKey === OPENAI_API_KEY) {
        markOpenAIKeyFailed();
        
        // Skús znova so záložným kľúčom
        if (OPENAI_API_KEY_BACKUP && OPENAI_API_KEY_BACKUP !== OPENAI_API_KEY) {
            error_log("OpenAI primary key failed, switching to backup key");
            return callGPT4($prompt, $lang, $maxWords); // Rekurzívne volanie
        }
    }
    
    if ($httpCode === 200) {
        $result = json_decode($response, true);
        if (isset($result['choices'][0]['message']['content'])) {
            $content = cleanGentlemanText($result['choices'][0]['message']['content'], $lang);
            $content = limitWords($content, $maxWords);
            
            // Preložiť ak potrebné
            if ($lang === 'sk' && !containsSlovakDiacritics($content)) {
                $content = translateWithDeepLPro($content, 'SK');
            }
            
            return $content;
        }
    }
    
    // Log error pre debug
    if (DEBUG_MODE) {
        error_log("OpenAI API error: HTTP $httpCode, Response: " . substr($response, 0, 200));
    }
    
    return null;
}

/**
 * ENHANCED: Gemini s gentlemánskym štýlom
 */
function callGemini($prompt, $lang = 'en', $maxWords = DEFAULT_MAX_WORDS) {
    if (!isServiceEnabled('gemini')) return null;
    
    $styleInstructions = $lang === 'sk' ?
        "Píš ako vzdelaný hudobný kritik. Používaj kultivovaný slovník bez bulvárnych frázok. Odpoveď v slovenčine." :
        "Write as an educated music critic. Use cultured vocabulary without tabloid phrases. Respond in English.";
    
    $enhancedPrompt = $styleInstructions . " " . $prompt;
    
    $url = "https://generativelanguage.googleapis.com/v1beta/models/gemini-pro:generateContent?key=" . GEMINI_API_KEY;
    
    $data = [
        'contents' => [[
            'parts' => [['text' => $enhancedPrompt]]
        ]],
        'generationConfig' => [
            'temperature' => 0.4,
            'maxOutputTokens' => 150  // ✅ ZVÝŠENÉ z 200 na 800
        ]
    ];
    
    $ch = curl_init();
    curl_setopt($ch, CURLOPT_URL, $url);
    curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
    curl_setopt($ch, CURLOPT_POST, true);
    curl_setopt($ch, CURLOPT_POSTFIELDS, json_encode($data));
    curl_setopt($ch, CURLOPT_HTTPHEADER, ['Content-Type: application/json']);
    curl_setopt($ch, CURLOPT_TIMEOUT, 15);
    
    $response = curl_exec($ch);
    $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
    curl_close($ch);
    
    if ($httpCode === 200) {
        $result = json_decode($response, true);
        if (isset($result['candidates'][0]['content']['parts'][0]['text'])) {
            $content = cleanGentlemanText($result['candidates'][0]['content']['parts'][0]['text'], $lang);
            $content = limitWords($content, $maxWords);
            
            // Preložiť ak potrebné
            if ($lang === 'sk' && !containsSlovakDiacritics($content)) {
                $content = translateWithDeepLPro($content, 'SK');
            }
            
            return $content;
        }
    }
    return null;
}

/**
 * NOVÉ: Utility funkcie
 */
function containsSlovakDiacritics($text) {
    return preg_match('/[ľščťžýáíéúäôň]/u', $text);
}

// NOVÁ FUNKCIA - Inteligentné obmedzenie textu
function limitWords($text, $maxWords = 50) {
    // Najprv skontroluj počet viet
    $sentences = preg_split('/[.!?]+/', $text, -1, PREG_SPLIT_NO_EMPTY);
    
    // Ak má viac ako 3 vety, použi len prvé 3
    if (count($sentences) > 3) {
        $text = implode('. ', array_slice($sentences, 0, 3)) . '.';
    }
    
    // Potom skontroluj počet slov
    $words = explode(' ', $text);
    if (count($words) > $maxWords) {
        // Nájdi koniec poslednej vety v limite
        $limitedWords = array_slice($words, 0, $maxWords);
        $limitedText = implode(' ', $limitedWords);
        
        // Ak text nekončí vetou, nájdi poslednú bodku
        if (!preg_match('/[.!?]$/', $limitedText)) {
            $lastDot = strrpos($limitedText, '.');
            if ($lastDot !== false) {
                $text = substr($limitedText, 0, $lastDot + 1);
            } else {
                $text = $limitedText . '.';
            }
        } else {
            $text = $limitedText;
        }
    }
    
    return $text;
}

function cleanText($text) {
    $text = preg_replace('/\[\d+\]/', '', $text);
    $text = preg_replace('/\s+/', ' ', $text);
    $text = preg_replace('/\.{2,}/', '.', $text);
    $text = trim($text, " \t\n\r\0\x0B\"'`");
    return $text;
}

/**
 * ENHANCED: Scoring pre gentlemanský štýl
 */
function scoreGentlemanContent($text, $lang) {
    $score = 0;
    $wordCount = str_word_count($text);
    
    // Dĺžka textu (optimálne 40-100 slov)
    if ($wordCount >= 40 && $wordCount <= 100) {
        $score += 30;
    } elseif ($wordCount >= 20 && $wordCount <= 150) {
        $score += 20;
    } else {
        $score += 10;
    }
    
    // Gentlemanské slová
    $gentlemanWords = GENTLEMAN_STYLE_WORDS[$lang] ?? GENTLEMAN_STYLE_WORDS['en'];
    foreach ($gentlemanWords as $word) {
        if (stripos($text, $word) !== false) {
            $score += 10;
        }
    }
    
    // Bonus za slovenské diakritiky (ak je SK)
    if ($lang === 'sk' && containsSlovakDiacritics($text)) {
        $score += 15;
    }
    
    // Trest za bulvárne frázy
    $forbidden = FORBIDDEN_PHRASES[$lang] ?? FORBIDDEN_PHRASES['en'];
    foreach ($forbidden as $phrase) {
        if (stripos($text, $phrase) !== false) {
            $score -= 20;
        }
    }
    
    // Bonus za kultivovanosť (obsahuje čísla, roky, fakty)
    if (preg_match('/\b(19|20)\d{2}\b/', $text)) $score += 10;
    if (preg_match('/\b\d+\b/', $text)) $score += 5;
    
    return min(100, max(0, $score));
}

/**
 * MAIN: Generovanie AI obsahu s gentlemánskym štýlom
 */
function generateGentlemanAIContent($artist, $title, $lang = 'en', $context = [], $maxWords = DEFAULT_MAX_WORDS) {
    // Check cache
    $cacheKey = getCacheKey($artist, $title, $lang, 'gentleman');
    $cached = getFromCache($cacheKey);
    if ($cached) {
        return $cached;
    }
    
    $contextInfo = '';
    if (!empty($context['year'])) $contextInfo .= "Vydané v roku {$context['year']}. ";
    if (!empty($context['genre'])) $contextInfo .= "Žáner: {$context['genre']}. ";
    if (!empty($context['album'])) $contextInfo .= "Album: {$context['album']}. ";
    
    // Gentlemanské prompty (bez bulvárnych frázok)
    $prompts = [
        'sk' => "Napíš KRÁTKY kultivovaný komentár o skladbe '{$title}' od {$artist} - MAXIMÁLNE 3 VETY. {$contextInfo}Použi formálny tón. Text musí byť KOMPLETNÝ a ukončený.",
        'en' => "Write a BRIEF cultured commentary about '{$title}' by {$artist} - MAXIMUM 3 SENTENCES. {$contextInfo}Use formal tone. Text must be COMPLETE and finished."
    ];
    
    $prompt = $prompts[$lang] ?? $prompts['en'];
    $attempts = [];
    
    // Try different AI providers with gentleman style
    if (isServiceEnabled('perplexity')) {
        $perplexityResult = callPerplexityForFacts($prompt, $lang, $maxWords);
        if ($perplexityResult) {
            $attempts[] = [
                'text' => $perplexityResult,
                'provider' => 'Perplexity',
                'score' => scoreGentlemanContent($perplexityResult, $lang)
            ];
        }
    }
    
    if (isServiceEnabled('openai')) {
        $gpt4Result = callGPT4($prompt, $lang, $maxWords);
        if ($gpt4Result) {
            $attempts[] = [
                'text' => $gpt4Result,
                'provider' => 'GPT-4',
                'score' => scoreGentlemanContent($gpt4Result, $lang)
            ];
        }
    }
    
    if (isServiceEnabled('gemini')) {
        $geminiResult = callGemini($prompt, $lang, $maxWords);
        if ($geminiResult) {
            $attempts[] = [
                'text' => $geminiResult,
                'provider' => 'Gemini',
                'score' => scoreGentlemanContent($geminiResult, $lang)
            ];
        }
    }
    
    // Select best result based on gentleman scoring
    if (!empty($attempts)) {
        // Ak je požadovaná slovenčina, preferuj slovenské texty
        if ($lang === 'sk') {
            foreach ($attempts as &$attempt) {
                if (containsSlovakDiacritics($attempt['text'])) {
                    $attempt['score'] += 20; // Bonus pre slovenské texty
                }
            }
        }
        
        usort($attempts, function($a, $b) {
            return $b['score'] - $a['score'];
        });
        
        $best = $attempts[0];
        $result = [
            'content' => $best['text'],
            'artist' => $artist,
            'title' => $title,
            'lang' => $lang,
            'style' => 'gentleman',
            'provider' => $best['provider'],
            'score' => $best['score'],
            'source' => 'AI',
            'timestamp' => time(),
            'timer_seconds' => DEFAULT_TIMER_SECONDS,
            'min_timer_seconds' => MIN_TIMER_SECONDS,
            'can_skip' => true,
            'max_words' => $maxWords,
            'word_count' => str_word_count($best['text']),
            'char_count' => strlen($best['text']),  // ✅ PRIDANÉ
            'alternatives' => array_values(array_filter(array_slice($attempts, 1, 3), function($alt) use ($lang) {
    // Pre slovenčinu akceptuj len texty s diakritikou
        if ($lang === 'sk') {
            return containsSlovakDiacritics($alt['text']);
        }
        return true;
        }
    })
        
        saveToCache($cacheKey, $result);
        return $result;
    }
    
    // Fallback
    return getGentlemanFallbackContent($artist, $title, $lang, $maxWords);
}

/**
 * NOVÉ: Gentlemanský fallback
 */
function getGentlemanFallbackContent($artist, $title, $lang, $maxWords = DEFAULT_MAX_WORDS) {
    $fallbacks = [
        'sk' => [
            "Skladba '{$title}' od {$artist} predstavuje zaujímavý príklad hudobného umenia. Dielo vyniká precíznym spracovaním a jedinečným prístupom k žánru.",
            "{$artist} vytvoril kompozíciu, ktorá elegantne spája tradičné prvky s moderným prístupom. Výsledkom je dielo oslovujúce široké publikum.",
            "Táto skladba demonštruje majstrovské ovládanie žánru. {$artist} dokázal vytvoriť nadčasové dielo.",
            "'{$title}' je dôkazom toho, že kvalitná hudba dokáže spájať generácie. Skladba kombinuje technickú dokonalosť s emocionálnou hĺbkou.",
            "{$artist} vytvoril dielo, ktoré rezonuje s poslucháčmi všetkých vekových kategórií. Skladba '{$title}' je skutočným hudobným skvostom."
        ],
        'en' => [
            "The composition '{$title}' by {$artist} represents an intriguing example of musical artistry. The work excels in precise craftsmanship and unique genre approach.",
            "{$artist} crafted a track that elegantly combines traditional elements with contemporary approaches. The result appeals to a wide audience.",
            "This musical piece demonstrates masterful genre command. {$artist} managed to create a timeless work.",
            "'{$title}' proves that quality music can unite generations. The track combines technical perfection with emotional depth.",
            "{$artist} created a work that resonates with listeners of all ages. The track '{$title}' is a true musical gem."
        ]
    ];
    
    $options = $fallbacks[$lang] ?? $fallbacks['en'];
    $selectedText = $options[array_rand($options)];
    $selectedText = limitWords($selectedText, $maxWords);
    
    return [
        'content' => $selectedText,  // ✅ Celý text
        'artist' => $artist,
        'title' => $title,
        'lang' => $lang,
        'style' => 'gentleman',
        'provider' => 'Fallback',
        'score' => 65,
        'source' => 'Fallback',
        'timestamp' => time(),
        'timer_seconds' => DEFAULT_TIMER_SECONDS,
        'min_timer_seconds' => MIN_TIMER_SECONDS,
        'can_skip' => true,
        'max_words' => $maxWords,
        'word_count' => str_word_count($selectedText),
        'char_count' => strlen($selectedText)  // ✅ PRIDANÉ
    ];
}

// Main execution
try {
    // Clean any previous output
    $previousOutput = ob_get_clean();
    
    // Check parameters
    if (!isset($_GET['artist']) || !isset($_GET['title'])) {
        echo json_encode([
            'error' => 'Missing required parameters',
            'required' => ['artist', 'title']
        ]);
        exit;
    }
    
    $artist = trim($_GET['artist']);
    $title = trim($_GET['title']);
    $lang = $_GET['lang'] ?? 'en';
    $maxWords = (int)($_GET['max_words'] ?? DEFAULT_MAX_WORDS);
    $style = $_GET['style'] ?? 'gentleman';
    
    // Validate parameters
    if (!in_array($lang, ['en', 'sk'])) {
        $lang = 'en';
    }
    
    if ($maxWords < 20 || $maxWords > 200) {
        $maxWords = DEFAULT_MAX_WORDS;
    }
    
    if (empty($artist) || empty($title)) {
        echo json_encode([
            'error' => 'Empty artist or title'
        ]);
        exit;
    }
    
    $context = [];
    if (!empty($_GET['year'])) $context['year'] = $_GET['year'];
    if (!empty($_GET['genre'])) $context['genre'] = $_GET['genre'];
    if (!empty($_GET['album'])) $context['album'] = $_GET['album'];
    
    // Check which AI services are available
    $availableServices = [];
    if (isServiceEnabled('perplexity')) $availableServices[] = 'Perplexity';
    if (isServiceEnabled('openai')) $availableServices[] = 'OpenAI';
    if (isServiceEnabled('gemini')) $availableServices[] = 'Gemini';
    
    if (empty($availableServices)) {
        // Use fallback if no AI services
        $result = getGentlemanFallbackContent($artist, $title, $lang, $maxWords);
        $result['available_services'] = [];
        $result['message'] = 'No AI services configured - using fallback content';
        echo json_encode($result, JSON_UNESCAPED_UNICODE);
        exit;
    }
    
    // Generate gentleman style content
    $result = generateGentlemanAIContent($artist, $title, $lang, $context, $maxWords);
    $result['available_services'] = $availableServices;
    
    echo json_encode($result, JSON_UNESCAPED_UNICODE);
    
} catch (Exception $e) {
    echo json_encode([
        'error' => 'Exception occurred',
        'message' => $e->getMessage()
    ]);
} catch (Error $e) {
    echo json_encode([
        'error' => 'Fatal error occurred',
        'message' => $e->getMessage()
    ]);
}

exit;
?>
