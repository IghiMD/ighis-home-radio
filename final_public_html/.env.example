# =============================================
# IGHI'S HOME RADIO - Environment Configuration
# =============================================
# Skopírujte tento súbor ako '.env' a vyplňte svoje hodnoty

# =============================================
# ZÁKLADNÉ NASTAVENIA
# =============================================

# Časové pásmo (PHP timezone)
TIMEZONE="Europe/Prague"

# Debug režim (true/false)
DEBUG_MODE=false

# =============================================
# STREAM KONFIGURÁCIA
# =============================================

# URL hlavného streamu
STREAM_URL="https://fra-pioneer01.dedicateware.com:2415/stream"

# ICY metadata server (relatívne k vašej doméne)
ICY_SERVER="metadata_proxy.php"

# =============================================
# API KĽÚČE - METADATA SLUŽBY
# =============================================

# Spotify Web API (FREEMIUM - registrácia na developer.spotify.com)
SPOTIFY_CLIENT_ID="your_spotify_client_id"
SPOTIFY_CLIENT_SECRET="your_spotify_client_secret"

# YouTube Data API v3 (FREEMIUM - Google Cloud Console)
YOUTUBE_API_KEY="your_youtube_api_key"

# Last.fm API (ZADARMO - last.fm/api/account/create)
LASTFM_API_KEY="your_lastfm_api_key"

# MusicBrainz API (ZADARMO - bez registrácie)
MUSICBRAINZ_ENABLED=true
MUSICBRAINZ_USER_AGENT="IghisHomeRadio/1.0 (hello@ighishomeradio.com)"

# Deezer API (ZADARMO - bez registrácie)
DEEZER_ENABLED=true

# =============================================
# API KĽÚČE - AI SLUŽBY
# =============================================

# Perplexity AI (PLATENÉ - perplexity.ai)
PERPLEXITY_API_KEY="your_perplexity_api_key"

# OpenAI GPT (PLATENÉ - platform.openai.com)
OPENAI_API_KEY="your_openai_api_key"
OPENAI_API_KEY_BACKUP="your_backup_openai_key"

# Google Gemini (FREEMIUM - makersuite.google.com/app/apikey)
# Free tier: 60 požiadaviek/minútu!
GEMINI_API_KEY="your_gemini_api_key"

# DeepL Translation API (FREEMIUM - deepl.com/pro-api)
# Free tier: 500,000 znakov/mesiac!
DEEPL_API_KEY="your_deepl_api_key"

# =============================================
# CHAT A PODPORA
# =============================================

# Crisp Chat Widget (FREEMIUM - crisp.chat)
CRISP_WEBSITE_ID="your_crisp_website_id"

# =============================================
# ADMIN PRÍSTUPY
# =============================================

# Admin používateľské meno
ADMIN_USERNAME="ighi"

# Admin heslo (ZMEŇTE!)
ADMIN_PASSWORD="VaseNoveSilneHeslo123!"

# API token pre automatizáciu (ZMEŇTE!)
ADMIN_TOKEN="vase-nahodny-bezpecny-token-123xyz"

# =============================================
# CACHE KONFIGURÁCIA
# =============================================

# Základný cache expiry (sekundy) - 24 hodín
CACHE_EXPIRY=86400

# AI trivia cache expiry (sekundy) - 7 dní
TRIVIA_CACHE_EXPIRY=604800

# Metadata cache expiry (sekundy) - 3 dni
METADATA_CACHE_EXPIRY=259200

# =============================================
# BACKUP SYSTÉM
# =============================================

# Maximálny počet záložných kópií
MAX_BACKUPS=168

# Povoliť zálohovanie (true/false)
BACKUP_ENABLED=true

# Automatické zálohovanie (true/false)
AUTO_BACKUP=true

# =============================================
# AI SYSTÉM KONFIGURÁCIA
# =============================================

# Maximálny počet slov v AI odpovedi
AI_MAX_WORDS=60

# Štýl AI odpovedí (gentleman, sarcastic, informative, witty)
AI_STYLE="gentleman"

# Minimálny čas zobrazenia AI info (sekundy)
AI_MIN_TIMER=8

# Predvolený čas zobrazenia AI info (sekundy)
AI_DEFAULT_TIMER=25

# =============================================
# SLUŽBY PRIORITY (1=najvyššia)
# =============================================

PRIORITY_SPOTIFY=1
PRIORITY_MUSICBRAINZ=2
PRIORITY_LASTFM=3
PRIORITY_DEEZER=4
PRIORITY_YOUTUBE=5

# =============================================
# RATE LIMITING (požiadavky za obdobie)
# =============================================

# Spotify API - požiadavky za hodinu
SPOTIFY_RATE_LIMIT=100

# YouTube API - požiadavky za deň
YOUTUBE_RATE_LIMIT=10000

# DeepL API - znaky za mesiac
DEEPL_RATE_LIMIT=500000

# Last.fm API - požiadavky za hodinu
LASTFM_RATE_LIMIT=300

# MusicBrainz API - požiadavky za sekundu
MUSICBRAINZ_RATE_LIMIT=1

# Gemini API - požiadavky za minútu
GEMINI_RATE_LIMIT=50

# OpenAI API - požiadavky za minútu
OPENAI_RATE_LIMIT=200

# =============================================
# SYSTÉMOVÉ NASTAVENIA
# =============================================

# Minimálna kvalita metadát (0-100)
MIN_METADATA_QUALITY=50

# Automatické obohacovanie metadát (true/false)
AUTO_ENRICH=true

# Delay pre obohacovanie (milisekundy)
ENRICH_DELAY=1000

# Trvanie notifikácií (milisekundy)
NOTIFICATION_DURATION=4000

# Interval kontroly ICY metadát (milisekundy)
ICY_CHECK_INTERVAL=3000

# =============================================
# NOTIFIKAČNÝ SYSTÉM (VOLITEĽNÉ)
# =============================================

# SMTP Email konfigurácia
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM_EMAIL="hello@ighishomeradio.com"
SMTP_FROM_NAME="Ighi's Home Radio"

# WhatsApp konfigurácia (CallMeBot alebo Twilio)
WHATSAPP_METHOD="callmebot"
WHATSAPP_API_KEY="your_callmebot_api_key"

# Twilio (alternatívne)
TWILIO_SID="your_twilio_sid"
TWILIO_TOKEN="your_twilio_token"
TWILIO_WHATSAPP="whatsapp:+14155238886"

# =============================================
# POKROČILÉ NASTAVENIA
# =============================================

# PHP memory limit pre väčšie operácie
PHP_MEMORY_LIMIT="256M"

# Maximálny čas vykonávania
PHP_MAX_EXECUTION_TIME=120

# Upload limity
PHP_UPLOAD_MAX_FILESIZE="10M"
PHP_POST_MAX_SIZE="10M"

# Session konfigurácia
SESSION_LIFETIME=14400
SESSION_NAME="IGHI_SESSION"

# =============================================
# DEVELOPMENT / TESTING
# =============================================

# Povoliť detailné error logy (iba pre development)
DETAILED_ERRORS=false

# Test režim pre API volania
API_TEST_MODE=false

# Simulovať AI odpovede (pre testing bez API kľúčov)
AI_SIMULATE_MODE=false

# =============================================
# POZNÁMKY PRE NASTAVENIE
# =============================================

# 1. POVINNÉ PRE ZÁKLADNÚ FUNKCIONALITU:
#    - ADMIN_PASSWORD (zmeňte!)
#    - ADMIN_TOKEN (zmeňte!)
#    - STREAM_URL

# 2. ODPORÚČANÉ PRE PLNÚ FUNKCIONALITU:
#    - GEMINI_API_KEY (60 req/min zadarmo!)
#    - SPOTIFY_CLIENT_ID + SECRET
#    - DEEPL_API_KEY (500k znakov/mesiac zadarmo!)

# 3. VOLITEĽNÉ PRE ROZŠÍRENÉ FUNKCIE:
#    - YOUTUBE_API_KEY
#    - LASTFM_API_KEY
#    - CRISP_WEBSITE_ID
#    - Email/WhatsApp notifikácie

# 4. BEZPEČNOSŤ:
#    - Nikdy nezdieľajte tento súbor s citlivými údajmi
#    - Pridajte .env do .gitignore
#    - Používajte silné heslá a tokeny